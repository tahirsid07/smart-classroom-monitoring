# Telegram is optional. Leave blank to disable Telegram alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Detection settings
CONFIDENCE_THRESHOLD=0.45
ALERT_COOLDOWN_SECONDS=30
CAMERA_SOURCE=0
YOLO_MODEL=yolo11n.pt
POSE_MODEL=yolo11n-pose.pt
POSE_KEYPOINT_CONFIDENCE=0.3
POSTURE_CONSECUTIVE_FRAMES=5
HEAD_DOWN_EAR_OFFSET=0.04
HAND_DOWN_SHOULDER_OFFSET=0.12
PHONE_USE_CONSECUTIVE_FRAMES=5
PHONE_USE_MOTION_THRESHOLD_PIXELS=8
PHONE_USE_UPPER_BODY_FRACTION=0.78

# Optional local face matching
STUDENT_GALLERY_DIR=data/students
FACE_MATCH_TOLERANCE=0.36
